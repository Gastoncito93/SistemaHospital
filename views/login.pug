extends layout

block content
  .auth-wrapper
    .auth-card
      .auth-header
        .auth-icon
          i.bi.bi-shield-lock-fill
        h2.auth-title Iniciar Sesión
        p.auth-subtitle Acceso al Portal de Gestión Hospitalaria
      
      .auth-body
        if error
          .alert.alert-danger.alert-custom(role="alert")
            i.bi.bi-exclamation-triangle-fill
            span= error
            
        form(action="/login" method="POST")
          .form-group-custom
            input.form-control.form-control-custom(type="email" name="email" id="email" placeholder="Correo Electrónico" required)
            i.bi.bi-envelope-fill
            
          .form-group-custom.mb-4
            input.form-control.form-control-custom(type="password" name="pass" id="pass" placeholder="Contraseña" required)
            i.bi.bi-key-fill
            
          button.btn.auth-btn(type="submit") 
            i.bi.bi-box-arrow-in-right.me-2
            | Entrar al Sistema
            
        .auth-footer
          | ¿No tienes cuenta? 
          a.auth-link(href="/registro") Regístrate aquí
