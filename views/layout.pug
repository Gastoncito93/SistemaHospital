doctype html
html
  head
    title HIS - Internación
    meta(charset="utf-8")
    meta(name="viewport", content="width=device-width, initial-scale=1")
    link(rel="stylesheet", href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css")
    link(rel="stylesheet", href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css")
    link(rel="stylesheet", href="/style.css")
  body
    // Navbar
    nav.navbar.navbar-expand-lg.navbar-dark.bg-dark
      .container-fluid
        a.navbar-brand(href="/") HIS Internación
        button.navbar-toggler(type="button", data-bs-toggle="collapse", data-bs-target="#navbarNav")
          span.navbar-toggler-icon
        #navbarNav.collapse.navbar-collapse
          ul.navbar-nav
            li.nav-item
              a.nav-link(href="/pacientes") Pacientes
            li.nav-item
              a.nav-link(href="/internaciones") Internaciones
            li.nav-item
              a.nav-link(href="/habitaciones") Habitaciones
            if rol === 'admin'
              li.nav-item
                a.nav-link(href="/usuarios") Usuarios
          
    // Contenido principal
    .container.mt-4
      block content

    // Modal de Alerta de Permisos
    #permisosModal.modal.fade(tabindex="-1", aria-labelledby="permisosModalLabel", aria-hidden="true")
      .modal-dialog.modal-dialog-centered
        .modal-content
          .modal-header.bg-danger.text-white
            h5#permisosModalLabel.modal-title
              i.bi.bi-exclamation-triangle-fill.me-2
              | Acceso Restringido
            button.btn-close.btn-close-white(type="button", data-bs-dismiss="modal", aria-label="Close")
          .modal-body
            p#permisosModalMessage.text-center.my-3.fw-semibold (Mensaje de error)
          .modal-footer
            button.btn.btn-secondary(type="button", data-bs-dismiss="modal") Entendido

    // Bootstrap JS para el navbar responsive
    script(src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js")

    // Script para capturar y mostrar errores en Pop-up
    script.
      document.addEventListener('DOMContentLoaded', function() {
        const urlParams = new URLSearchParams(window.location.search);
        if (urlParams.has('error')) {
          const mensaje = urlParams.get('error');
          document.getElementById('permisosModalMessage').textContent = mensaje;
          const myModal = new bootstrap.Modal(document.getElementById('permisosModal'));
          myModal.show();
          
          // Limpiar el parámetro de la URL sin recargar la página
          const newUrl = window.location.pathname;
          window.history.replaceState({}, document.title, newUrl);
        }
      });
