extends layout

block content
  .auth-wrapper
    .auth-card
      .auth-header
        .auth-icon
          i.bi.bi-person-plus-fill
        h2.auth-title Crear Cuenta
        p.auth-subtitle Registro de Personal del Hospital
      
      .auth-body
        if error
          .alert.alert-danger.alert-custom(role="alert")
            i.bi.bi-exclamation-triangle-fill
            span= error
            
        form(action="/registro" method="POST")
          .row
            .col-md-6
              .form-group-custom
                input.form-control.form-control-custom(type="text" name="nombre" id="nombre" placeholder="Nombre" required)
                i.bi.bi-person-fill
            .col-md-6
              .form-group-custom
                input.form-control.form-control-custom(type="text" name="apellido" id="apellido" placeholder="Apellido" required)
                i.bi.bi-person-badge
                
          .form-group-custom
            input.form-control.form-control-custom(type="text" name="dni" id="dni" placeholder="DNI" required)
            i.bi.bi-card-text
            
          .form-group-custom
            input.form-control.form-control-custom(type="email" name="email" id="email" placeholder="Correo Electrónico" required)
            i.bi.bi-envelope-fill
            
          .form-group-custom.mb-4
            input.form-control.form-control-custom(type="password" name="pass" id="pass" placeholder="Contraseña" required)
            i.bi.bi-key-fill
            
          button.btn.auth-btn(type="submit") 
            i.bi.bi-person-check-fill.me-2
            | Completar Registro
            
        .auth-footer
          | ¿Ya tienes cuenta? 
          a.auth-link(href="/login") Inicia sesión aquí

  script.
    document.addEventListener('DOMContentLoaded', function() {
      const form = document.querySelector('form');
      if (form) {
        form.addEventListener('submit', async function(e) {
          e.preventDefault();
          
          // Limpiar errores previos
          document.querySelectorAll('.error-message').forEach(el => el.remove());
          document.querySelectorAll('.form-control-custom').forEach(el => {
            el.style.borderColor = '';
            el.style.boxShadow = '';
          });
          
          const alertDanger = document.querySelector('.alert-danger');
          if (alertDanger) alertDanger.remove();
          
          try {
            const formData = new URLSearchParams(new FormData(form));
            const response = await fetch(form.action, {
              method: 'POST',
              headers: {
                'Accept': 'application/json',
                'Content-Type': 'application/x-www-form-urlencoded'
              },
              body: formData
            });
            
            const result = await response.json();
            
            if (response.ok && result.success) {
              window.location.href = result.redirectUrl;
            } else if (result.errores) {
              for (const [key, msg] of Object.entries(result.errores)) {
                const inputEl = document.getElementById(key);
                if (inputEl) {
                  // Agregar borde rojo
                  inputEl.style.borderColor = '#e74c3c';
                  inputEl.style.boxShadow = '0 0 0 0.2rem rgba(231, 76, 60, 0.25)';
                  
                  // Crear mensaje de error
                  const errEl = document.createElement('div');
                  errEl.className = 'error-message text-danger mt-1 text-start';
                  errEl.style.fontSize = '0.8rem';
                  errEl.style.paddingLeft = '10px';
                  errEl.textContent = msg;
                  
                  const parentGroup = inputEl.closest('.form-group-custom') || inputEl;
                  parentGroup.after(errEl);
                  
                  // Limpiar el error cuando el usuario vuelva a escribir
                  inputEl.addEventListener('input', function onInputReset() {
                    this.style.borderColor = '';
                    this.style.boxShadow = '';
                    const next = this.closest('.form-group-custom')?.nextElementSibling || this.nextElementSibling;
                    if (next && next.classList.contains('error-message')) {
                      next.remove();
                    }
                    this.removeEventListener('input', onInputReset);
                  });
                }
              }
            } else if (result.message) {
              // Error general
              const alertEl = document.createElement('div');
              alertEl.className = 'alert alert-danger alert-custom';
              alertEl.innerHTML = `<i class="bi bi-exclamation-triangle-fill"></i> <span>${result.message}</span>`;
              form.prepend(alertEl);
            }
          } catch (error) {
            console.error('Error al registrar:', error);
          }
        });
      }
    });