extends ../layout

block content
  style.
    :root {
      --hospital-blue: #0d8abc;
      --hospital-teal: #00c2cb;
      --hospital-light: #e8f4f8;
      --hospital-white: #ffffff;
      --hospital-gray: #f8f9fa;
      --hospital-dark: #2c3e50;
      --hospital-green: #2ecc71;
      --hospital-red: #e74c3c;
      --hospital-yellow: #f39c12;
    }
    
    .historial-header {
      background: linear-gradient(135deg, var(--hospital-blue), var(--hospital-teal));
      color: white;
      border-radius: 12px;
      padding: 1.5rem;
      margin-bottom: 2rem;
      box-shadow: 0 6px 15px rgba(13, 138, 188, 0.15);
    }

    .patient-card {
      background: white;
      border-radius: 12px;
      border-left: 5px solid var(--hospital-blue);
      box-shadow: 0 4px 8px rgba(0, 0, 0, 0.05);
      padding: 1.5rem;
      margin-bottom: 2rem;
    }

    .internacion-card {
      background: white;
      border-radius: 12px;
      border: 1px solid #e2e8f0;
      box-shadow: 0 4px 6px rgba(0, 0, 0, 0.02);
      margin-bottom: 2rem;
      overflow: hidden;
    }

    .internacion-header {
      background-color: #f8fafc;
      border-bottom: 1px solid #e2e8f0;
      padding: 1rem 1.5rem;
    }

    .internacion-body {
      padding: 1.5rem;
    }

    .eval-section-title {
      border-bottom: 2px solid #e2e8f0;
      padding-bottom: 0.5rem;
      margin-bottom: 1rem;
      font-weight: 600;
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .eval-item {
      background-color: #f8fafc;
      border-radius: 8px;
      border: 1px solid #e2e8f0;
      padding: 1rem;
      margin-bottom: 1rem;
    }

    .vitals-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(110px, 1fr));
      gap: 10px;
      margin-top: 10px;
    }

    .vital-badge {
      background-color: white;
      border: 1px solid #cbd5e1;
      border-radius: 6px;
      padding: 5px 8px;
      text-align: center;
      font-size: 0.85rem;
    }

    .vital-val {
      font-weight: bold;
      color: var(--hospital-blue);
      display: block;
      font-size: 1.05rem;
    }

  //- Header principal
  .historial-header.d-flex.justify-content-between.align-items-center.flex-wrap.gap-2
    div
      h1.mb-1
        i.bi.bi-folder2-open.me-2
        | Historia Clínica Única
      p.mb-0 Registro unificado de antecedentes e internaciones del paciente
    a.btn.btn-light(href="/pacientes")
      i.bi.bi-arrow-left.me-2
      | Volver a Pacientes

  //- Datos del paciente
  .patient-card
    .row
      .col-md-3.col-6.mb-3.mb-md-0
        small.text-muted.text-uppercase.fw-semibold Paciente
        h4.mb-0.fw-bold= paciente.nombre + ' ' + paciente.apellido
      .col-md-3.col-6.mb-3.mb-md-0
        small.text-muted.text-uppercase.fw-semibold DNI
        h5.mb-0= paciente.dni
      .col-md-3.col-6
        small.text-muted.text-uppercase.fw-semibold Sexo
        h5.mb-0.text-capitalize= paciente.sexo
      .col-md-3.col-6
        small.text-muted.text-uppercase.fw-semibold ID Paciente
        h5.mb-0 # #{paciente.id}

  h3.mb-4.fw-bold.mt-4
    i.bi.bi-clock-history.me-2
    | Historial de Internaciones

  if internaciones.length > 0
    each internacion in internaciones
      .internacion-card
        //- Cabecera de la Internación
        .internacion-header.d-flex.justify-content-between.align-items-center.flex-wrap.gap-2
          div
            span.fw-bold.fs-5 Internación N° #{internacion.id}
            span.ms-3.badge(class=`bg-${internacion.estado_internacion === 'alta' ? 'secondary' : 'success'}`)
              = internacion.estado_internacion === 'alta' ? 'Alta Médica' : 'Activa'
          div.text-muted
            i.bi.bi-calendar-check.me-1
            | Ingreso: #{new Date(internacion.fecha_ingreso).toLocaleDateString('es-ES')}
            if internacion.habitacion_numero
              span.ms-3
                i.bi.bi-hospital.me-1
                | Habitación: #{internacion.habitacion_numero} (Ala #{internacion.ala_nombre || 'N/A'})

        .internacion-body
          //- Detalles del Ingreso
          .row.mb-4
            .col-md-6.mb-3.mb-md-0
              h6.fw-bold.text-muted Detalle de Entrada
              p.mb-1 <strong>Tipo de Ingreso:</strong> #{internacion.tipo_ingreso || 'No especificado'}
              p.mb-1 <strong>Origen:</strong> #{internacion.origen_paciente || 'No especificado'}
              p.mb-0 <strong>Motivo principal:</strong> #{internacion.motivo}
            .col-md-6
              if internacion.estado_internacion === 'alta'
                .p-3.bg-light.border.rounded.border-secondary
                  h6.fw-bold.text-secondary
                    i.bi.bi-box-arrow-right.me-1
                    | Datos de Alta
                  p.mb-1 <strong>Fecha Alta:</strong> #{internacion.fecha_alta ? new Date(internacion.fecha_alta).toLocaleDateString('es-ES') : 'N/A'}
                  p.mb-0 <strong>Motivo Alta:</strong> #{internacion.motivo_alta || 'N/A'}
              else if internacion.observaciones
                h6.fw-bold.text-muted Observaciones de Ingreso
                p.text-muted= internacion.observaciones

          //- Evaluaciones
          .row.mt-4
            //- Columna Médica
            .col-lg-6.mb-4.mb-lg-0
              h5.eval-section-title.text-success
                i.bi.bi-activity
                | Evaluaciones Médicas (#{internacion.evaluacionesMedicas.length})
              
              if internacion.evaluacionesMedicas.length > 0
                each evMed in internacion.evaluacionesMedicas
                  .eval-item
                    .d-flex.justify-content-between.mb-2
                      span.badge.bg-success= new Date(evMed.fecha_hora).toLocaleString('es-ES')
                      small.text-muted ID Eval: #{evMed.id}
                    p.mb-1 <strong>Diagnóstico:</strong> #{evMed.diagnostico}
                    p.mb-1 <strong>Evolución:</strong> #{evMed.evolucion}
                    p.mb-1 <strong>Tratamiento:</strong> #{evMed.tratamiento}
                    p.mb-1 <strong>Medicación:</strong> #{evMed.medicacion}
                    if evMed.estudios_solicitados
                      p.mb-1 <strong>Estudios solicitados:</strong> #{evMed.estudios_solicitados}
                    if evMed.notas
                      p.mb-0.text-muted.small <em>Notas: #{evMed.notas}</em>
              else
                p.text-muted.small.italic No se registran evaluaciones médicas para esta internación.

            //- Columna Enfermería
            .col-lg-6
              h5.eval-section-title.text-info
                i.bi.bi-clipboard-pulse
                | Controles de Enfermería (#{internacion.evaluacionesEnfermeria.length})
              
              if internacion.evaluacionesEnfermeria.length > 0
                each evEnf in internacion.evaluacionesEnfermeria
                  .eval-item
                    .d-flex.justify-content-between.mb-2
                      span.badge.bg-info= new Date(evEnf.fecha_hora).toLocaleString('es-ES')
                      small.text-muted ID Control: #{evEnf.id}
                    if evEnf.motivo
                      p.mb-1 <strong>Motivo control:</strong> #{evEnf.motivo}
                    if evEnf.sintomas
                      p.mb-1 <strong>Síntomas:</strong> #{evEnf.sintomas}
                    
                    //- Grilla de Signos Vitales
                    .vitals-grid
                      if evEnf.presion_arterial
                        .vital-badge
                          span.text-muted.small Presión
                          span.vital-val= evEnf.presion_arterial
                      if evEnf.frecuencia_cardiaca
                        .vital-badge
                          span.text-muted.small Pulso (FC)
                          span.vital-val #{evEnf.frecuencia_cardiaca} lpm
                      if evEnf.temperatura
                        .vital-badge
                          span.text-muted.small Temp
                          span.vital-val #{evEnf.temperatura} °C
                      if evEnf.saturacion_oxigeno
                        .vital-badge
                          span.text-muted.small SpO2
                          span.vital-val #{evEnf.saturacion_oxigeno}%
                      if evEnf.dolor
                        .vital-badge
                          span.text-muted.small Dolor
                          span.vital-val #{evEnf.dolor}/10

                    if evEnf.medicacion_actual
                      p.mb-1.mt-2 <strong>Medicación actual:</strong> #{evEnf.medicacion_actual}
                    if evEnf.alergias
                      p.mb-1 <strong>Alergias anotadas:</strong> <span class="text-danger">#{evEnf.alergias}</span>
                    if evEnf.notas
                      p.mb-0.text-muted.small.mt-2 <em>Notas: #{evEnf.notas}</em>
              else
                p.text-muted.small.italic No se registran controles de enfermería para esta internación.
  else
    .alert.alert-warning
      i.bi.bi-exclamation-triangle.me-2
      | El paciente no registra antecedentes de internación en el sistema.

  //- Script para Bootstrap Icons si faltan
  script.
    if (!document.querySelector('link[href*="bootstrap-icons"]')) {
      const link = document.createElement('link');
      link.rel = 'stylesheet';
      link.href = 'https://cdn.jsdelivr.net/npm/bootstrap-icons@1.8.1/font/bootstrap-icons.css';
      document.head.appendChild(link);
    }
