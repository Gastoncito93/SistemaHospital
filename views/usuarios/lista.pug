extends ../layout

block content
  style.
    :root {
      --hospital-blue: #0d8abc;
      --hospital-teal: #00c2cb;
      --hospital-light: #e8f4f8;
      --hospital-white: #ffffff;
      --hospital-gray: #f8f9fa;
      --hospital-dark: #2c3e50;
      --hospital-purple: #9b59b6;
    }
    
    .hospital-header {
      background: linear-gradient(135deg, var(--hospital-purple), #6c5ce7);
      color: white;
      border-radius: 12px;
      padding: 1.5rem;
      margin-bottom: 2rem;
      box-shadow: 0 6px 15px rgba(155, 89, 182, 0.15);
    }
    
    .hospital-title {
      font-weight: 600;
      margin-bottom: 0.5rem;
      display: flex;
      align-items: center;
      gap: 10px;
    }
    
    .hospital-title i {
      font-size: 1.8rem;
    }
    
    .hospital-subtitle {
      opacity: 0.9;
      font-size: 0.95rem;
    }
    
    .hospital-table {
      background: white;
      border-radius: 12px;
      overflow: hidden;
      box-shadow: 0 5px 15px rgba(0, 0, 0, 0.05);
      border: none;
    }
    
    .hospital-table thead {
      background: linear-gradient(to right, #f8f9fa, #e9ecef);
      color: var(--hospital-dark);
      font-weight: 600;
      text-transform: uppercase;
      font-size: 0.85rem;
      letter-spacing: 0.5px;
    }
    
    .hospital-table th {
      border-bottom: 2px solid var(--hospital-purple);
      padding: 1rem;
    }
    
    .hospital-table td {
      padding: 1rem;
      vertical-align: middle;
      border-top: 1px solid #f0f0f0;
    }
    
    .role-form {
      display: flex;
      align-items: center;
      gap: 10px;
    }
    
    .role-select {
      max-width: 150px;
      padding: 0.375rem 1.75rem 0.375rem 0.75rem;
      font-size: 0.9rem;
      border-radius: 8px;
    }

    .user-avatar {
      width: 40px;
      height: 40px;
      border-radius: 50%;
      background: linear-gradient(135deg, var(--hospital-purple), #6c5ce7);
      color: white;
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: 600;
      margin-right: 10px;
    }
    
    .user-info {
      display: flex;
      align-items: center;
    }

    .user-name {
      font-weight: 600;
      color: var(--hospital-dark);
    }

  .hospital-header
    h1.hospital-title
      i.bi.bi-people-fill
      | Gestión de Usuarios
    p.hospital-subtitle.mb-0
      | Panel de Administración - Control de Roles e Integrantes del Sistema

  .table-responsive
    table.table.table-hover.hospital-table
      thead
        tr
          th(scope="col") Usuario
          th(scope="col") Email
          th(scope="col") Rol Actual
          th(scope="col") Cambiar Rol
      tbody
        each usr in usuarios
          tr
            td
              .user-info
                .user-avatar= usr.nombre.charAt(0).toUpperCase() + usr.apellido.charAt(0).toUpperCase()
                div
                  .user-name= usr.nombre + ' ' + usr.apellido
                  small.text-muted ID: #{usr.id}
            td= usr.email
            td
              span.badge(class=`bg-${usr.rol === 'admin' ? 'danger' : usr.rol === 'medico' ? 'success' : 'info'}`)= usr.rol
            td
              if userId && usr.id === userId
                span.text-muted (Tu usuario)
              else
                form.role-form(method="POST", action=`/usuarios/actualizar-rol/${usr.id}`)
                  select.form-select.role-select(name="rol")
                    option(value="enfermero" selected=usr.rol === 'enfermero') Enfermero
                    option(value="medico" selected=usr.rol === 'medico') Médico
                    option(value="admin" selected=usr.rol === 'admin') Admin
                  button.btn.btn-sm.btn-primary(type="submit") Actualizar

  //- Script para Bootstrap Icons si faltan
  script.
    if (!document.querySelector('link[href*="bootstrap-icons"]')) {
      const link = document.createElement('link');
      link.rel = 'stylesheet';
      link.href = 'https://cdn.jsdelivr.net/npm/bootstrap-icons@1.8.1/font/bootstrap-icons.css';
      document.head.appendChild(link);
    }
