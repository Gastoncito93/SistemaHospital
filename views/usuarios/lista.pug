extends ../layout

block content
  style.
    :root {
      --hospital-blue: #0d8abc;
      --hospital-teal: #00c2cb;
      --hospital-light: #e8f4f8;
      --hospital-white: #ffffff;
      --hospital-gray: #f8f9fa;
      --hospital-dark: #2c3e50;
      --hospital-purple: #9b59b6;
      --hospital-amber: #f59e0b;
    }
    
    .hospital-header {
      background: linear-gradient(135deg, var(--hospital-purple), #6c5ce7);
      color: white;
      border-radius: 12px;
      padding: 1.5rem;
      margin-bottom: 2rem;
      box-shadow: 0 6px 15px rgba(155, 89, 182, 0.15);
    }
    
    .hospital-title {
      font-weight: 600;
      margin-bottom: 0.5rem;
      display: flex;
      align-items: center;
      gap: 10px;
    }
    
    .hospital-title i {
      font-size: 1.8rem;
    }
    
    .hospital-subtitle {
      opacity: 0.9;
      font-size: 0.95rem;
    }
    
    .hospital-table {
      background: white;
      border-radius: 12px;
      overflow: hidden;
      box-shadow: 0 5px 15px rgba(0, 0, 0, 0.05);
      border: none;
    }
    
    .hospital-table thead {
      background: linear-gradient(to right, #f8f9fa, #e9ecef);
      color: var(--hospital-dark);
      font-weight: 600;
      text-transform: uppercase;
      font-size: 0.85rem;
      letter-spacing: 0.5px;
    }
    
    .hospital-table th {
      border-bottom: 2px solid var(--hospital-purple);
      padding: 1rem;
    }
    
    .hospital-table td {
      padding: 1rem;
      vertical-align: middle;
      border-top: 1px solid #f0f0f0;
    }
    
    /* Estilos para Pendientes */
    .pending-section {
      margin-bottom: 3rem;
    }
    
    .pending-table {
      border: 2px solid var(--hospital-amber);
    }
    
    .pending-table thead {
      background: linear-gradient(to right, #fef3c7, #fde68a);
      color: #92400e;
    }
    
    .pending-table th {
      border-bottom: 2px solid var(--hospital-amber);
    }
    
    .pending-row {
      background-color: #fffbeb;
      transition: background-color 0.2s ease;
    }
    
    .pending-row:hover {
      background-color: #fef3c7 !important;
    }
    
    .pending-avatar {
      background: linear-gradient(135deg, var(--hospital-amber), #d97706) !important;
    }
    
    .section-title {
      font-size: 1.3rem;
      font-weight: 700;
      color: var(--hospital-dark);
      margin-bottom: 1rem;
      display: flex;
      align-items: center;
      gap: 10px;
    }
    
    .role-form {
      display: flex;
      align-items: center;
      gap: 10px;
    }
    
    .role-select {
      max-width: 170px;
      padding: 0.375rem 1.75rem 0.375rem 0.75rem;
      font-size: 0.9rem;
      border-radius: 8px;
    }

    .user-avatar {
      width: 40px;
      height: 40px;
      border-radius: 50%;
      background: linear-gradient(135deg, var(--hospital-purple), #6c5ce7);
      color: white;
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: 600;
      margin-right: 10px;
    }
    
    .user-info {
      display: flex;
      align-items: center;
    }

    .user-name {
      font-weight: 600;
      color: var(--hospital-dark);
    }

  .hospital-header
    h1.hospital-title
      i.bi.bi-people-fill
      | Gestión de Usuarios
    p.hospital-subtitle.mb-0
      | Panel de Administración - Control de Roles e Integrantes del Sistema

  - const pendientes = usuarios.filter(u => u.rol === 'pendiente')
  - const activos = usuarios.filter(u => u.rol !== 'pendiente')

  //- SECCIÓN 1: PENDIENTES DE APROBACIÓN
  .pending-section
    h2.section-title.text-warning
      i.bi.bi-person-exclamation.text-warning
      | Usuarios Pendientes de Aprobación 
      span.badge.bg-warning.text-dark.ms-2= pendientes.length

    if pendientes.length > 0
      .table-responsive
        table.table.table-hover.hospital-table.pending-table
          thead
            tr
              th(scope="col") Usuario
              th(scope="col") Email
              th(scope="col") Estado
              th(scope="col") Asignar Rol y Autorizar
          tbody
            each usr in pendientes
              tr.pending-row
                td
                  .user-info
                    .user-avatar.pending-avatar= usr.nombre.charAt(0).toUpperCase() + usr.apellido.charAt(0).toUpperCase()
                    div
                      .user-name= usr.nombre + ' ' + usr.apellido
                      small.text-muted ID: #{usr.id}
                td= usr.email
                td
                  span.badge.bg-warning.text-dark
                    i.bi.bi-clock-fill.me-1
                    | Pendiente
                td
                  form.role-form(method="POST", action=`/usuarios/actualizar-rol/${usr.id}`)
                    select.form-select.role-select(name="rol" required)
                      option(value="" disabled selected) -- Seleccionar Rol --
                      option(value="enfermero") Enfermero
                      option(value="medico") Médico
                    button.btn.btn-sm.btn-warning.text-dark.fw-bold(type="submit")
                      i.bi.bi-shield-check.me-1
                      | Autorizar
    else
      .alert.alert-success.d-flex.align-items-center.gap-3.border-0.shadow-sm.p-3(style="border-radius: 12px; background-color: #ecfdf5;")
        i.bi.bi-check-circle-fill.text-success.fs-4
        div(style="font-size: 0.95rem; font-weight: 500; color: #065f46;")
          | No hay usuarios pendientes de aprobación. Todo el personal cuenta con un rol asignado y acceso activo.

  //- SECCIÓN 2: PERSONAL ACTIVO
  .active-section
    h2.section-title
      i.bi.bi-person-check-fill.text-primary
      | Personal del Hospital Activo 
      span.badge.bg-primary.ms-2= activos.length

    .table-responsive
      table.table.table-hover.hospital-table
        thead
          tr
            th(scope="col") Usuario
            th(scope="col") Email
            th(scope="col") Rol Actual
            th(scope="col") Cambiar Rol
        tbody
          each usr in activos
            tr
              td
                .user-info
                  .user-avatar= usr.nombre.charAt(0).toUpperCase() + usr.apellido.charAt(0).toUpperCase()
                  div
                    .user-name= usr.nombre + ' ' + usr.apellido
                    small.text-muted ID: #{usr.id}
              td= usr.email
              td
                span.badge(class=`bg-${usr.rol === 'admin' ? 'danger' : usr.rol === 'medico' ? 'success' : 'info'}` style="text-transform: capitalize;")= usr.rol
              td
                if userId && usr.id === userId
                  span.text-muted.small.fw-bold (Tu usuario actual)
                else
                  form.role-form(method="POST", action=`/usuarios/actualizar-rol/${usr.id}`)
                    select.form-select.role-select(name="rol" required)
                      option(value="enfermero" selected=usr.rol === 'enfermero') Enfermero
                      option(value="medico" selected=usr.rol === 'medico') Médico
                    button.btn.btn-sm.btn-primary(type="submit")
                      i.bi.bi-arrow-repeat.me-1
                      | Cambiar
